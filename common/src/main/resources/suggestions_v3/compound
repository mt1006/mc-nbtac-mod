effect
+id :RegistryKey(minecraft:mob_effect) @Recommended(3)
+amplifier :byte @Recommended(2)
+duration :int @Recommended(1)
+ambient :boolean
+show_particles :boolean
+show_icon :boolean

effect_with_hidden &effect
+hidden_effect :#effect

sound_event
+sound_id :RegistryKey(minecraft:sound_event) @Recommended
+range :float

item_effect
+type :Enum(apply_effects, remove_effects, clear_all_effects, teleport_randomly, play_sound) @Recommended
+effects :Depends<list<#effect>, SingleOrList<RegistryKey(minecraft:mob_effect)>>(type, apply_effects, remove_effects) @RelevantIfEq(type, apply_effects, remove_effects)
+probability :float @RelevantIfEq(type, apply_effects)
+diameter :float @RelevantIfEq(type, teleport_randomly)
+sound :either<RegistryKey(minecraft:sound_event), #sound_event> @RelevantIfEq(type, play_sound)

