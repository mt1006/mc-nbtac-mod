{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",

	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": ["${mod_author}"],
	"contact":
	{
		"homepage": "${homepage}",
		"sources": "${source_url}",
		"issues": "${issue_tracker}"
	},

	"license": "${license}",
	"icon": "logo.png",

	"environment": "client",
	"entrypoints":
	{
		"main": ["net.mt1006.nbtac.NBTacFabric"],
		"modmenu": ["net.mt1006.nbtac.fabric.ModMenuApiImpl"],
		"fabric-client-gametest": ["net.mt1006.nbtac.test.NBTacTest"]
	},
	"mixins": ["nbtac.mixins.json", "nbtac.fabric.mixins.json"],

	"depends":
	{
		"minecraft": "${version_range_fabric}",
		"fabricloader": ">=0.16.0",
		"fabric-api": "*",
		"java": ">=${java_version}"
	}
}
